# FitFuel Environment Configuration Template
# Copy this file to .env and configure your values: cp .env.example .env

PORT=3000

# Database Configuration:
# Leave blank to automatically use local SQLite (file:fitfuel.db)
# Or provide your Turso database credentials for cloud sync:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Master Admin Claim Secret (Required for claiming administrator status)
ADMIN_SECRET=your_secure_admin_secret_here

# Optional: Server-Side AI Coach Keys (Can also be set in the UI under Settings)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
